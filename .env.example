# ==========================================
# UZEX AI — Environment Configuration Template
# ==========================================

# Telegram Bot Configuration (Required)
BOT_TOKEN=your_telegram_bot_token_here

# Google Gemini API Configuration (Optional)
# If omitted or invalid, the bot transparently runs in 100% deterministic mode
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# SQLite Database Path (Relative to project root or absolute)
DATABASE_PATH=data/processed/uzex.db

# Timeouts in seconds
QUERY_TIMEOUT_SECONDS=30
MAX_RESPONSE_TIME_SECONDS=85
